        <vendit>
            <general>
                <enabled>0</enabled>
                <enable_product_import>1</enable_product_import>
                <enable_stock_import>1</enable_stock_import>
                <enable_category_import>1</enable_category_import>
                <enable_customer_import>1</enable_customer_import>
                <enable_order_update_import>1</enable_order_update_import>
                <enable_order_export>1</enable_order_export>

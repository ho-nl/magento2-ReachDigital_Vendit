<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <vendit>
            <directory_mapping>
                <import>
                    <product_path>vendit/import/products</product_path>
                    <product_file>Products.xml</product_file>
                    <stock_path>vendit/import/stock</stock_path>
                    <stock_file>Stock.xml</stock_file>
                    <category_path>vendit/import/categories</category_path>
                    <category_file>Groups.xml</category_file>
                    <customer_path>vendit/import/customers</customer_path>
                    <customer_file>Customers.xml</customer_file>
                </import>
                <export>
                    <product_path>vendit/export/products</product_path>
                    <product_file>Products.xml</product_file>
                    <stock_path>vendit/export/stock</stock_path>
                    <stock_file>Stock.xml</stock_file>
                    <category_path>vendit/export/categories</category_path>
                    <category_file>Groups.xml</category_file>
                    <customer_path>vendit/export/customers</customer_path>
                    <customer_file>Customers.xml</customer_file>
                </export>
            </directory_mapping>
        </vendit>
    </default>
</config>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="vendit" translate="label" sortOrder="210">
            <label>Vendit</label>
        </tab>
        <section id="vendit" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>General Configuration</label>
            <tab>vendit</tab>
            <resource>ReachDigital_Vendit::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="version" translate="label" type="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Version</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\System\Config\Version</frontend_model>
                </field>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Enable or disable the complete Vendit integration.]]></comment>
                </field>
                <field id="order_export_start_date" translate="label comment" type="text" sortOrder="15" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Order Export Start Date</label>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Only orders placed on or after this date/time will be exported to Vendit.<br/>
                        <strong>Format:</strong> <code>YYYY-MM-DD HH:MM:SS</code> — e.g. <code>2024-05-27 14:30:00</code><br/>
                        <strong style="color: #eb5202;">Required:</strong> when not set, the entire module is considered disabled.]]></comment>
                </field>
            </group>
            <!-- @todo Disabled in v1.0 — not yet ready for production -->
            <!--
            <group id="product_import" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Product Import</label>
                <field id="enable_product_import" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Product Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            -->
            <group id="price_import" translate="label" type="text" sortOrder="105" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Price Import</label>
                <field id="enable_price_import" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Price Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Import product prices (and action/special prices) from Vendit Products XML files.]]></comment>
                </field>
            </group>
            <group id="stock_import" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Stock Import</label>
                <field id="enable_stock_import" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Stock Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="disable_on_out_of_stock" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Disable Product When Out of Stock</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[When enabled, products are automatically set to <strong>Disabled</strong> in the catalog when their stock quantity reaches 0 during a stock import.]]></comment>
                </field>
                <field id="enable_on_back_in_stock" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Re-enable Product When Back in Stock</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[When enabled, products are automatically set to <strong>Enabled</strong> in the catalog when their stock quantity goes above 0 during a stock import.]]></comment>
                </field>
            </group>
            <!-- @todo Disabled in v1.0 — not yet ready for production -->
            <!--
            <group id="category_import" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Category Import</label>
                <field id="enable_category_import" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Category Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            -->
            <!-- @todo Disabled in v1.0 — not yet ready for production -->
            <!--
            <group id="customer_import" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Customer Import</label>
                <field id="enable_customer_import" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Customer Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            -->
            <group id="order_update_import" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Order Update Import</label>
                <field id="enable_order_update_import" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Order Update Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="order_export" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Order Export</label>
                <field id="enable_order_export" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Order Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="export_xml_retention_months" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Export XML Retention (Months)</label>
                    <comment><![CDATA[Number of months to keep the exported order XML in the database. Set to 0 or leave empty to disable automatic cleanup.]]></comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
            </group>
            <group id="import_cleanup" translate="label" type="text" sortOrder="160" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Import File Cleanup</label>
                <field id="processed_retention_days" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Processed Files Retention (Days)</label>
                    <comment><![CDATA[Number of days to keep successfully imported files in the <code>processed</code> subdirectory. Set to 0 or leave empty to disable automatic cleanup.]]></comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
                <field id="failed_retention_days" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Failed Files Retention (Days)</label>
                    <comment><![CDATA[Number of days to keep failed import files in the <code>failed</code> subdirectory. Set to 0 or leave empty to disable automatic cleanup.]]></comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
            </group>
            <group id="directory_mapping" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Directory Mapping</label>
                <field id="var_directory_info" translate="label" type="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Base Directory</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\System\Config\VarDirectory</frontend_model>
                </field>
                <group id="import" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Import</label>
                    <comment><![CDATA[<strong style="color: #eb5202;">Warning:</strong> Do not change these settings unless you know what you are doing. These paths must match your Vendit FTP/SFTP configuration.]]></comment>
                    <field id="file_path" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>File Path</label>
                    </field>
                    <field id="product_file_prefix" translate="label" type="text" sortOrder="11" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Product File Prefix</label>
                    </field>
                    <field id="stock_file_prefix" translate="label" type="text" sortOrder="12" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Stock File Prefix</label>
                    </field>
                    <field id="customer_file_prefix" translate="label" type="text" sortOrder="14" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Customer File Prefix</label>
                    </field>
                    <field id="image_path" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Images Path</label>
                    </field>
                    <field id="order_path" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Order Updates File Path</label>
                    </field>
                </group>
                <group id="export" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Export</label>
                    <comment><![CDATA[<strong style="color: #eb5202;">Warning:</strong> Do not change these settings unless you know what you are doing. These paths must match your Vendit FTP/SFTP configuration.]]></comment>
                    <field id="order_path" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Orders File Path</label>
                    </field>
                    <field id="order_file" translate="label" type="text" sortOrder="55" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Orders File</label>
                        <comment><![CDATA[Where <code>%s</code> is the timestamp and/or order number.<br/>
                        For example: Order_%s.xml]]></comment>
                    </field>
                </group>
            </group>
        </section>
        <section id="vendit_mapping" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Import/Export Mapping</label>
            <tab>vendit</tab>
            <resource>ReachDigital_Vendit::config</resource>
            <group id="attribute_mapping" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Product Attribute Mapping</label>
                <comment><![CDATA[Map Vendit Specs to Magento product attributes. Spec names are case-sensitive.]]></comment>
                <!-- @todo Disabled in v1.0 — not yet ready for production -->
                <!--
                <field id="size_attribute" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Size Attribute</label>
                    <comment><![CDATA[Select which product attribute to use for configurable product size variations (maps to Vendit 'Size' field).]]></comment>
                    <source_model>ReachDigital\Vendit\Model\Config\Source\ProductAttributes</source_model>
                    <validate>required</validate>
                </field>
                <field id="color_attribute" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Color Attribute</label>
                    <comment><![CDATA[Select which product attribute to use for configurable product color variations (maps to Vendit 'Color' field).]]></comment>
                    <source_model>ReachDigital\Vendit\Model\Config\Source\ProductAttributes</source_model>
                    <validate>required</validate>
                </field>
                -->
                <field id="barcode_attribute" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Barcode Attribute</label>
                    <comment><![CDATA[Select which product attribute to store the barcode (EAN) imported from Vendit. Used when exporting orders back to Vendit.]]></comment>
                    <source_model>ReachDigital\Vendit\Model\Config\Source\ProductAttributes</source_model>
                    <validate>required</validate>
                </field>
                <field id="barcode_fallback_to_sku" translate="label comment" type="select" sortOrder="21" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Fallback to SKU</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[When enabled, the product SKU is used as the EAN value in order exports if the barcode attribute is empty.]]></comment>
                </field>
                <!-- @todo Disabled in v1.0 — not yet ready for production -->
                <!--
                <field id="tax_class_id" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Tax Class</label>
                    <comment><![CDATA[Select which tax class to apply to imported products.]]></comment>
                    <source_model>Magento\Tax\Model\TaxClass\Source\Product</source_model>
                    <validate>required</validate>
                </field>
                <field id="required_attributes" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Required Attributes</label>
                    <comment><![CDATA[Comma-separated list of Magento attribute codes.
                    Products will be skipped during import if any of these attributes have empty values.
                    This prevents the import from failing when the supplied data is incomplete.]]></comment>
                </field>
                <field id="attributes" translate="label" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Attribute Mapping</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\Form\Field\AttributeMapping</frontend_model>
                    <backend_model>ReachDigital\Vendit\Model\Config\Backend\AttributeMapping</backend_model>
                </field>
                -->
            </group>
            <group id="stock_import" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Stock Import</label>
                <field id="sku_source" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>SKU Source</label>
                    <source_model>ReachDigital\Vendit\Model\Config\Source\StockSkuSource</source_model>
                    <comment><![CDATA[Select which field from the Vendit stock XML to use as the product SKU. Use <strong>Barcode</strong> when the Magento SKU matches the EAN/barcode value rather than the Vendit ProductId.]]></comment>
                </field>
            </group>
            <group id="order_status_mapping" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Order Status Mapping</label>
                <comment><![CDATA[Map Vendit order statuses to Magento order statuses. This is used by the order update import.]]></comment>
                <field id="status_mapping" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Status Mapping</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\Form\Field\OrderStatusMapping</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <comment><![CDATA[Map Vendit Status Enum values to Magento order statuses. The Status Enum value can be found in the
                    order updates XML file (<code>StatusEnumValue</code> field in the <code>&lt;Order&gt;</code> element). Optional: add the Vendit Status Description for future reference (found in <code>OrderStatusList</code>).<br/>
                    The Magento statuses are grouped by order state.<br/>
                    <b>Note:</b> When a Vendit status enum is not mapped here, only a comment will be added to the order in Magento - the status will remain unchanged.<br/>
                    <b style="color: #eb5202">Important note:</b> By default, the 'Gefactureerd' Vendit status (Enum: 9) is linked to the 'complete' status.
                    This means that a shipment is created in Magento to complete the order. If the order should remain processing in Magento, please
                    link the 'Gefactureerd' Vendit status to the 'processing' Magento status instead, or completely remove the mapping rule.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>

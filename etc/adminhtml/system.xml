                <field id="manual_export" translate="label" type="button" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Manual Export</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\System\Config\ExportButton</frontend_model>
                </field>
                <field id="last_export" translate="label" type="label" sortOrder="20" showInDefault="1">
                    <label>Last Export</label>
                    <frontend_model>ReachDigital\Vendit\Block\Adminhtml\System\Config\ExportInfo</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
